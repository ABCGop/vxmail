# ==============================================================================
# VxMail Environment Configuration Template
# Domain: vxmusic.in | Mail Subdomain: mail.vxmusic.in
# ==============================================================================

# Database
# Local SQLite development mode:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL mode (Docker / VPS):
# DATABASE_URL="postgresql://vxmail:vxmail_secret_2026@localhost:5432/vxmail?schema=public"

# Redis (BullMQ queue broker & session caching)
REDIS_URL="redis://localhost:6379"

# Security & Authentication Secrets (Change in production!)
NEXTAUTH_SECRET="vxmail-production-secure-jwt-signing-key-32bytes-min-secret"
JWT_SECRET="vxmail-production-secure-jwt-signing-key-32bytes-min-secret"

# Stalwart Mail Server Core
MAIL_SERVER_HOST="mail.vxmusic.in"
MAIL_SERVER_PORT="8080"
MAIL_SERVER_USERNAME="admin"
MAIL_SERVER_PASSWORD="change_stalwart_admin_password"

# SMTP Submission (Outbound Mail Transport)
SMTP_HOST="mail.vxmusic.in"
SMTP_PORT="587"
SMTP_USERNAME="smtp@vxmusic.in"
SMTP_PASSWORD="change_smtp_password"
SMTP_SECURE="false"

# S3-Compatible Object Storage (Attachments)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="vxmail_s3_admin"
S3_SECRET_KEY="vxmail_s3_supersecret_key"
S3_BUCKET="vxmail-attachments"
S3_REGION="us-east-1"

# Observability & Error Tracking
SENTRY_DSN=""

# Application Mode
NODE_ENV="development"
